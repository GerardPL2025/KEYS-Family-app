# Copy to .env (never commit .env) and fill in.
# Run locally with:  flutter run -d chrome --dart-define-from-file=.env
# In GitHub Actions these come from repository secrets / variables instead.

# Supabase (Project Settings -> API). The publishable key is public by design;
# Row Level Security protects the data. Leave empty to run without a backend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Firebase Hosting project ID (GitHub repository *variable*, used only by CI).
FIREBASE_PROJECT_ID=

# GitHub repository *secret* only, never in .env or code:
# FIREBASE_SERVICE_ACCOUNT  (JSON key of the Firebase Hosting service account)
